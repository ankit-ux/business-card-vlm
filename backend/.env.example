# ---- VLM provider ----
# "dashscope" = call Qwen-VL via Alibaba Cloud DashScope API (recommended, works on free-tier CPU EC2)
# "local"     = load Qwen2.5-VL weights locally with transformers (needs a GPU instance, NOT free tier)
VLM_PROVIDER=dashscope

# Required when VLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODEL=qwen-vl-plus

# Required when VLM_PROVIDER=local
LOCAL_MODEL_NAME=Qwen/Qwen2.5-VL-3B-Instruct

# Comma separated list of allowed CORS origins, or * for all.
# Example for a specific server: ALLOWED_ORIGINS=http://51.20.68.136
ALLOWED_ORIGINS=*

# Max upload size per image, MB
MAX_IMAGE_MB=10
